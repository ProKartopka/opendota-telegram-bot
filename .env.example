# Скопируйте этот файл в .env и подставьте свои значения.
# Файл .env нельзя коммитить в репозиторий.

# Токен бота от @BotFather
BOT_TOKEN=

# Ключ Steam Web API (нужен для ссылок вида steamcommunity.com/id/<имя>)
# Получить: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Путь к файлу базы данных SQLite (необязательно).
# Если строка закомментирована или переменной нет, база создаётся рядом с кодом
# в файле userdata.db. Не оставляйте здесь пустое значение (DB_FILE=):
# пустая строка не считается «переменная не задана», и бот не найдёт файл.
# На хостинге укажите путь внутри постоянного тома, например /data/userdata.db.
# DB_FILE=userdata.db